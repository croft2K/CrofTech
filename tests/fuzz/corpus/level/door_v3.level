croftech_level 3
# A trigger that opens a door made of one brush.
brush
    vertex 0 0 0
    vertex 4 0 0
    vertex 0 4 0
    vertex 4 4 0
    vertex 0 0 -1
    vertex 4 0 -1
    vertex 0 4 -1
    vertex 4 4 -1
    face 1 3 7 5
    face 0 4 6 2
    face 2 6 7 3
    face 0 1 5 4
    face 4 5 7 6
    face 0 2 3 1
end

entity door
    name gate
    move 0 0 2
    brush
        vertex 1 0 0
        vertex 2 0 0
        vertex 1 1 0
        vertex 2 1 0
        vertex 1 0 2
        vertex 2 0 2
        vertex 1 1 2
        vertex 2 1 2
        face 1 3 7 5
        face 0 4 6 2
        face 2 6 7 3
        face 0 1 5 4
        face 4 5 7 6
        face 0 2 3 1
    end
end

entity trigger
    output on_enter gate open 0.5
    brush
        vertex 0 2 0
        vertex 4 2 0
        vertex 0 4 0
        vertex 4 4 0
        vertex 0 2 2
        vertex 4 2 2
        vertex 0 4 2
        vertex 4 4 2
        face 1 3 7 5
        face 0 4 6 2
        face 2 6 7 3
        face 0 1 5 4
        face 4 5 7 6
        face 0 2 3 1
    end
end
