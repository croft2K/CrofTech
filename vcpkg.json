{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "croftech",
  "version-semver": "0.1.0",
  "builtin-baseline": "69a1a33b4ba2b21e392c17e215ff637290778a97",
  "dependencies": [
    "doctest"
  ],
  "features": {
    "client": {
      "description": "Client and renderer: window, input and Vulkan",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        "vk-bootstrap",
        "volk",
        "vulkan-memory-allocator"
      ]
    },
    "profiling": {
      "description": "Tracy profiler client",
      "dependencies": [
        "tracy"
      ]
    }
  }
}
